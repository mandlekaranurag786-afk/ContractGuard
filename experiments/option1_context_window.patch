@@ -120,6 +121,21 @@ def build_context_spans(chunks: list[Chunk]) -> list[ContextSpan]:
     return spans
 
 
+def quote_context(
+    extraction: Extraction, chunks: list[Chunk], window: int = QUOTE_CONTEXT_WINDOW
+) -> str | None:
+    """Return a bounded window around the first continuous normalized quote."""
+    quote = normalize(extraction.evidence_quote or "")
+    if not quote:
+        return None
+    for span in build_context_spans(chunks):
+        text = normalize(span.text)
+        start = text.find(quote)
+        if start >= 0:
+            return text[max(0, start - window):start + len(quote) + window]
+    return None
+
+
 def _compact(text: str) -> str:
     return re.sub(r"\s+", "", normalize(text))
 
