+)
+def test_initial_term_context_uses_window_around_quote(
+    evidence_level, gap, expected_code
+):
+    from contractguard.chunking import Chunk
+
+    quote = (
+        "this Agreement shall be renewed automatically for a further period of "
+        "twelve (12) months unless either Party gives written notice not fewer "
+        "than ninety (90) days prior to expiry"
+    )
+    proving_sentence = (
+        "shall remain in full force until the third anniversary of the Effective "
+        "Date (such period of thirty-six (36) months being referred to herein "
+        'as the "Initial Term"). '
+    )
+    retrieved = [
+        Chunk(
+            chunk_id="doc:0", doc_id="doc", text=proving_sentence,
+            char_start=0, char_end=len(proving_sentence), page_start=1, page_end=1,
+        ),
+        Chunk(
+            chunk_id="doc:1", doc_id="doc", text=quote,
+            char_start=len(proving_sentence) + gap,
+            char_end=len(proving_sentence) + gap + len(quote),
+            page_start=1, page_end=1,
+        ),
+    ]
+
+    class ContextExtractor(FakeExtractor):
+        def extract(self, clause_type, chunks):
+            result = super().extract(clause_type, chunks)
+            result.extraction = RenewalTermExtraction(
+                found=True, initial_term_months=36, auto_renews=True,
+                renewal_term_months=12, notice_days=90,
+                evidence_quote=quote, evidence_chunk_id="doc:1",
+            )
+            result.checks = {
+                "evidence_level": evidence_level, "required_fields_present": True,
+                "not_found_is_clean": True,
+            }
+            return result
+
+    service = ContractChecker(
+        ContextExtractor(), document_loader=document,
+        retriever_builder=lambda _: FakeRetriever(retrieved),
+    )
+    initial_rule = Rule(
+        id="initial_term_max_60", description="Initial term at most 60 months",
+        clause_type="Renewal Term", field="initial_term_months",
+        operator="<=", threshold=60,
+    )
+    answer = service.check("fake.pdf", [initial_rule], "policy.json").rule_results[0]
+    if expected_code is not None:
+        assert answer.reason_code == expected_code
+    if expected_code == "compared":
+        assert answer.decision == Decision.PASS
+        assert "thirty-six (36) months" in answer.evidence_quote
+        assert answer.confidence_level == "MEDIUM"
+    else:
+        assert answer.decision == Decision.NEEDS_REVIEW
+        assert answer.evidence_quote == quote
